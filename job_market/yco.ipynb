    "req = requests.get(\"https://www.ycombinator.com/jobs\")\n",
    "html = req.text\n",
    "bs = BeautifulSoup(html)\n",
    "body = bs.body\n",
    "import pdb; pdb.set_trace()\n",
    "print(body.find_all(\"li\"))"
   ]
